{
  "expo": {
    "name": "Language Buddy",
    "slug": "language-buddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "languagebuddy",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.artur.languagebuddy",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow Language Buddy to access your microphone for spoken language practice."
      }
    },
    "android": {
      "package": "com.artur.languagebuddy",
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Language Buddy to access your microphone for spoken language practice.",
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
