# Frontend exposed port on host (default 8080)
FRONTEND_PORT=8080

# Google Gemini API Key (needed for Phase 1+ Live voice loop and Phase 2+ planner/analyst)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend session signing secret (random string)
SESSION_SECRET=change_me_super_secret_session_key_32_chars_long

# MongoDB connection string (inside Docker network: mongodb://db:27017/language_buddy)
MONGO_URL=mongodb://db:27017/language_buddy

# API port inside container
PORT=3000
NODE_ENV=production
